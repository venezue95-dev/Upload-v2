# ============================================================
#  toDus S3 Uploader Bot — plantilla de configuración
#  Copia este archivo a .env y rellena tus credenciales.
# ============================================================

# ----------------------- Telegram ---------------------------
# Credenciales de https://my.telegram.org → API development tools
API_ID=
API_HASH=
# Token de @BotFather
BOT_TOKEN=
BOT_SESSION_NAME=s3_bot_session
# Tu ID (habla con @userinfobot). Podrá cambiar /settings y usar /stats.
BOT_OWNER_ID=
# Usuarios autorizados separados por coma. Vacío = bot público.
BOT_ALLOWED_USERS=

# ----------------------- Almacenamiento ---------------------
# Todas las opciones S3_* se pueden cambiar en caliente con /settings.
MAX_FILE_MB=800
S3_CHUNK_SIZE_MB=50
S3_MAX_PARALLEL=3
S3_MAX_RETRIES=5
# Subidas simultáneas en TODO el bot (clave para aguantar 40 usuarios).
S3_GLOBAL_WORKERS=6
# Prefijo de las claves en el bucket y URL base (vacío = la de la librería).
S3_KEY_PREFIX=users
# S3_BASE_URL=https://s3.todus.cu/stream
S3_TIMEOUT=300

# ----------------------- Cola -------------------------------
# Tareas activas a la vez en todo el bot (2-8 según el servidor).
QUEUE_MAX_CONCURRENT=4
# Tareas activas por usuario (1 = cola justa, 2-3 = más agresivo).
QUEUE_MAX_PER_USER=1
# Tareas en espera (global y por usuario).
QUEUE_MAX_TOTAL=200
QUEUE_MAX_WAITING_PER_USER=15
# Segundos mínimos entre envíos de un mismo usuario (anti-spam).
RATE_LIMIT_SEC=3
# Duración máxima de una tarea antes de abortarla (minutos).
TASK_TIMEOUT_MIN=240
# Reparto justo: el que no tiene nada activo pasa antes.
FAIR_SCHEDULING=true
# Reintentos automáticos completos de una tarea que falló al empezar.
TASK_AUTO_RETRIES=1
# Prioridad extra para las tareas del owner.
OWNER_PRIORITY=5

# ----------------------- Descargas --------------------------
# auto  = streaming si el origen lo permite (recomendado)
# stream= siempre streaming · off = descargar todo y luego subir
STREAM_MODE=auto
# Descargas simultáneas desde Telegram (semáforo de Pyrogram).
TG_CONCURRENT_DOWNLOADS=4
# Workers del dispatcher de Pyrogram.
TELEGRAM_WORKERS=12
# No aceptar descargas si el disco libre baja de este valor (GB).
MIN_FREE_GB=2
# Permitir URLs a IPs privadas (¡solo para pruebas!).
ALLOW_PRIVATE_URLS=false

# ----------------------- Interfaz y rutas -------------------
PROGRESS_INTERVAL_SEC=3
LOG_LEVEL=INFO
DOWNLOAD_DIR=/app/downloads
WORK_DIR=/app/data
DATA_DIR=/app/data
