# toDus S3 Uploader Bot - Configuración

# ============================================================
# Telegram (obtener en https://my.telegram.org)
# ============================================================
API_ID=123456
API_HASH=tu_api_hash
BOT_TOKEN=123456:tu_token_de_BotFather
BOT_SESSION_NAME=s3_bot_session

# ID del propietario del bot (puede cambiar /settings vía botones).
# Habla con @userinfobot para saber tu ID.
BOT_OWNER_ID=123456789

# Usuarios autorizados a usar el bot (separados por coma).
# Vacío = bot público.
BOT_ALLOWED_USERS=

# Máximo por archivo (MB). Por defecto 800 MB (límite toDus).
MAX_FILE_MB=800

# ============================================================
# toDus (vía librería todus)
# ============================================================
# La librería `todus` (https://github.com/nyxthor-dev/todus-client)
# gestiona la autenticación internamente: NO hace falta token.
# Cada usuario de Telegram tiene su propio namespace `tg_<user_id>`,
# creado automáticamente la primera vez que sube un archivo.

# Directorios (dentro del contenedor Docker). No tocar salvo necesidad.
DOWNLOAD_DIR=/app/downloads
WORK_DIR=/app/data

# ============================================================
# Parámetros de subida por chunks (mutables vía /settings)
# ============================================================
# Tamaño de cada chunk en MB. Cada chunk es un archivo completo en
# el namespace del usuario (la librería todus no soporta multipart).
# Valores sugeridos: 10 / 50 / 100 / 200 / 400 / 800 / 1500 / 2000 (cycle en /settings).
S3_CHUNK_SIZE_MB=50

# Workers paralelos para subir chunks.
S3_MAX_PARALLEL=3

# Reintentos por chunk antes de declarar error crítico.
S3_MAX_RETRIES=10

# ============================================================
#  NUEVAS OPCIONES (v2) — valores por defecto.
#  Están comentadas: si no las tocas, el bot usa estos valores.
#  Todas se pueden cambiar en caliente con /settings cuando el bot
#  esté corriendo (menos las marcadas con *).
# ============================================================

# ---- Cola (clave para 20-40 usuarios) ----
# QUEUE_MAX_CONCURRENT=4          # tareas activas a la vez en todo el bot
# QUEUE_MAX_PER_USER=1            # tareas activas por usuario (1 = equitativo)
# QUEUE_MAX_TOTAL=200             # máximo de tareas en espera
# QUEUE_MAX_WAITING_PER_USER=15   # máximo en espera por usuario
# RATE_LIMIT_SEC=3                # espera mínima entre envíos de un usuario
# TASK_TIMEOUT_MIN=240            # aborta una tarea colgada (minutos)
# TASK_AUTO_RETRIES=1             # reintentos automáticos al empezar
# OWNER_PRIORITY=5                # prioridad extra para el owner

# ---- Subida ----
# S3_GLOBAL_WORKERS=6             # subidas simultáneas en todo el bot
# S3_TIMEOUT=300                  # timeout por subida (segundos)
# S3_KEY_PREFIX=users             # carpeta raíz en el bucket
# S3_BASE_URL=                    # vacío = la de la librería toDus

# ---- Descargas / disco ----
# YTDLP_COOKIES=               # cookies.txt Netscape de YouTube; usar como secreto
# STREAM_MODE=auto                # * auto | stream | classic (descargar+subir a la vez)
# TG_CONCURRENT_DOWNLOADS=4       # * descargas simultáneas desde Telegram
# TELEGRAM_WORKERS=12             # * workers del dispatcher de Pyrogram
# MIN_FREE_GB=2                   # no descargar si queda menos disco libre
# ALLOW_PRIVATE_URLS=false        # permitir enlaces a IPs internas (solo pruebas)
# GPLAY_ACCOUNT_EMAIL=            # cuenta secundaria de Google para Play Store
# GPLAY_AAS_TOKEN=                # token AAS persistente; secreto, no publicarlo
# GPLAY_AUTH_JSON=                # alternativa: contenido de .gplay-auth.json, como secreto
# PLAYSTORE_DISPENSER_URL=        # URL de un dispenser compatible con Google Play
# FAIR_SCHEDULING=true            # reparto justo entre usuarios

# ---- Interfaz ----
# PROGRESS_INTERVAL_SEC=3         # segundos entre refrescos del progreso
# LOG_LEVEL=INFO                  # DEBUG para ver más detalle en los logs
